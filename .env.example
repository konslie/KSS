# OpenDART disclosures
DART_API_KEY=your_dart_api_key_here

# Naver Search API for Korean holding news
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# KRX Data Marketplace Open API
# Use the API authentication key issued by KRX Open API.
KRX_AUTH_KEY=your_krx_auth_key_here
# Optional override. Use the sample base only for KRX sample tests.
KRX_OPEN_API_BASE=https://data-dbg.krx.co.kr/svc/apis

# Optional pykrx fallback login. Used only when KRX Open API is unavailable.
KRX_ID=your_krx_login_id_here
KRX_PW=your_krx_login_password_here

# Optional KRX investor flow Open API endpoints.
# Fill these only when KRX grants investor-flow APIs for your key.
# Values are paths relative to KRX_OPEN_API_BASE.
KRX_INVESTOR_MARKET_API_PATH=
KRX_INVESTOR_HOLDING_API_PATH=
